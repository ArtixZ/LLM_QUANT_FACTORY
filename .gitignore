# Data and generated research artifacts (root-anchored so AutoAlpha source paths stay tracked)
/data/
/datasets/
/raw/
/processed/
/interim/
/outputs/
/reports/
/results/
/artifacts/
/cache/

# Python
__pycache__/
*.py[cod]
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Notebooks and local runtime
.jupyter/
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.temp
.DS_Store

# Databases and backups (defensive; runtime state must never reach Git)
*.db
*.db-shm
*.db-wal
*.duckdb
*.duckdb.wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.bak

# Environment and secrets
.env
.env.*
!.env.example
.secrets/
*.key
*.p12
*.pem

# Backup of the pre-merge nested AutoAlpha git directory
/.git-autoalpha-backup/

# Claude Code session state and worktrees
.claude/
