# Local service addresses
AUTOALPHA_HOST=127.0.0.1
AUTOALPHA_PORT=8788
AUTOCOMBINE_HOST=127.0.0.1
AUTOCOMBINE_PORT=8888
QUANTCOMBINE_PORT=8889

# Local paths
AUTOALPHA_DATA_PATH=~/MarketData/US
AUTOALPHA_RUNTIME=runtime-full-llm
AUTOALPHA_CONFIG=config/research.toml

# Control-plane authentication. Set a strong value before non-loopback use.
AUTOALPHA_SERVICE_TOKEN=
AUTOALPHA_SECURE_COOKIE=false

# Optional OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1
AUTOALPHA_MODEL=
AUTOALPHA_API_KEY=
AUTOALPHA_FULL_LLM=false

# Interactive Brokers TWS / Gateway (paper, read-only by default)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_READONLY=true
IBKR_REQUIRE_PAPER_ACCOUNT=true
# Required only for foreground `daily_run.py --submit --confirm`.
QUANTFACTORY_MANAGED_ACCOUNT=

# Resource controls
AUTOALPHA_MAX_CONCURRENT_RESEARCH=2
AUTOCOMBINE_CONCURRENCY=1
QUANTCOMBINE_MAX_CONCURRENT=1
AUTOALPHA_OPTION_WORKERS=4
AUTOALPHA_PROPOSAL_BATCH_SIZE=4
AUTOALPHA_SHARED_SIGNAL_CACHE_SIZE=128

# Persistence. SQLite is the local default.
AUTOALPHA_DATABASE_BACKEND=sqlite
# AUTOALPHA_DATABASE_URL=postgresql://user:password@localhost:5432/autoalpha

# Explicit task restoration. Empty means no task is auto-resumed.
AUTOALPHA_RESUME_TASK_ID=
AUTOCOMBINE_RESUME_TASK_ID=

# Background services
AUTOALPHA_SYSTEM_JOB_WORKER_ENABLED=true
QUANTCOMBINE_AUTOSTART_REPAIR_TASKS=false
